# 复制为 .env 后填写。.env 已在 .gitignore 中，不会被提交。

# 中转站接口地址：一般是 OpenAI 兼容格式，通常以 /v1 结尾
DEEPSEEK_BASE_URL=https://your-relay.example.com/v1
DEEPSEEK_API_KEY=sk-xxxx
DEEPSEEK_MODEL=deepseek-v4-flash-0731

# 可选：中转站单价（美元 / 百万 tokens），用于计算成本
PRICE_INPUT=
PRICE_INPUT_CACHE_HIT=
PRICE_OUTPUT=

# 可选：Semantic Scholar API key，避免限流
S2_API_KEY=
